{
  "manifest_version": 3,
  "name": "Kindle to PDF Converter",
  "version": "1.1.0",
  "description": "Kindle Cloud ReaderからPDFを生成するブラウザ拡張機能（目次保持、画像品質調整対応）",

  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://read.amazon.com/*",
    "https://read.amazon.co.jp/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://read.amazon.com/*",
        "https://read.amazon.co.jp/*"
      ],
      "js": [
        "lib/browser-polyfill.min.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "lib/*"
      ],
      "matches": [
        "https://read.amazon.com/*",
        "https://read.amazon.co.jp/*"
      ]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "kindle-to-pdf@example.com",
      "strict_min_version": "109.0"
    }
  }
}
